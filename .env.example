# 复制为 .env 后使用。不要把真实 .env、密码或令牌提交到 Git。

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_USERNAME=zhidu_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_URL=jdbc:mysql://mysql:3306/learning_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# 登录与角色
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_TTL_SECONDS=86400
TEACHER_REGISTRATION_CODE=replace-with-school-teacher-code
ADMIN_EMAIL=admin@example.edu.cn
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 文件目录（Docker Compose 已映射为持久卷；手动部署时改为服务器绝对路径）
APP_UPLOAD_DIR=/app/uploads
APP_REPORT_DIR=/app/reports

# CORS：填写学校正式前端域名；多个地址使用英文逗号分隔
CORS_ALLOWED_ORIGINS=https://learning.example.edu.cn

# Neo4j
NEO4J_ENABLED=true
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password
NEO4J_CONNECTION_TIMEOUT_MS=2000
NEO4J_ACQUISITION_TIMEOUT_MS=2000
NEO4J_RETRY_TIMEOUT_MS=800
NEO4J_FAILURE_COOLDOWN_MS=10000

# Playwright 端到端测试（仅测试环境使用）
E2E_ADMIN_EMAIL=admin@example.edu.cn
E2E_ADMIN_PASSWORD=replace-with-the-test-admin-password
E2E_TEACHER_REGISTRATION_CODE=replace-with-the-test-teacher-code
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=3306
E2E_DB_USERNAME=zhidu_app
E2E_DB_PASSWORD=replace-with-the-test-database-password
E2E_DB_NAME=learning_platform
